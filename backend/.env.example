APP_NAME=ResumeX API
APP_ENV=development
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://resumex:change_me@localhost:5432/resumex
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
MATCH_REQUIRED_WEIGHT=3
MATCH_PREFERRED_WEIGHT=1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
SEMANTIC_SIMILARITY_THRESHOLD=0.65
MATCH_EVIDENCE_WEIGHT=0.7
MATCH_SEMANTIC_WEIGHT=0.3
